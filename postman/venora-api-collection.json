{
  "info": {
    "_postman_id": "venora-stage1-collection",
    "name": "Venora API - Stage1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/health",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8000",
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Login - SuperAdmin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "super@venora.local",
              "type": "text"
            },
            {
              "key": "password",
              "value": "superpass",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:8000/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8000",
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let j = pm.response.json();",
              "if (j && j.access_token) {",
              "  pm.environment.set('access_token', j.access_token);",
              "  pm.environment.set('role', j.role || '');",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
